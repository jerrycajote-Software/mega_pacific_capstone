// Prisma Schema - Mega Pacific Roofing System
// Prisma v7: URL is defined in prisma.config.ts, NOT here

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 Int      @id @default(autoincrement())
  email              String   @unique
  password           String
  role               String   @default("customer")
  status             String   @default("active") // active, pending, suspended, deleted
  deletedAt          DateTime?
  createdAt          DateTime @default(now())
  orders             Order[]
  reviews            Review[]
  inquiries          Inquiry[]
  sentMessages       Message[]
  isEmailVerified    Boolean   @default(false)
  otpCode            String?
  otpExpiresAt       DateTime?
  lastOtpSentAt      DateTime?
  resetOtpCode       String?   // For forgot-password flow
  resetOtpExpiresAt  DateTime?
  replies            ReviewReply[]
  inventoryLogs      InventoryLog[]
  addresses          Address[]
  sessions           UserSession[]
  coilInventoryLogs  CoilInventoryLog[]
  refunds            Refund[]          @relation("CustomerRefunds")
  processedRefunds   Refund[]          @relation("FinanceProcessedRefunds")
  
  customerProfile    CustomerProfile?
  adminProfile       AdminProfile?
  superAdminProfile  SuperAdminProfile?
  ownerProfile       OwnerProfile?
  salesProfile       SalesProfile?
  logisticProfile    LogisticProfile?
  financeProfile     FinanceProfile?
}

model CustomerProfile {
  id            Int      @id @default(autoincrement())
  userId        Int      @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String?
  contactNumber String?
  address       String?
  city          String?
  province      String?
  zipCode       String?
  avatarUrl     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model AdminProfile {
  id            Int      @id @default(autoincrement())
  userId        Int      @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String?
  contactNumber String?
  avatarUrl     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SuperAdminProfile {
  id            Int      @id @default(autoincrement())
  userId        Int      @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String?
  contactNumber String?
  avatarUrl     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model OwnerProfile {
  id            Int      @id @default(autoincrement())
  userId        Int      @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String?
  contactNumber String?
  avatarUrl     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SalesProfile {
  id            Int      @id @default(autoincrement())
  userId        Int      @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String?
  contactNumber String?
  avatarUrl     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model LogisticProfile {
  id            Int      @id @default(autoincrement())
  userId        Int      @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String?
  contactNumber String?
  avatarUrl     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model FinanceProfile {
  id            Int      @id @default(autoincrement())
  userId        Int      @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String?
  contactNumber String?
  avatarUrl     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Address {
  id            Int      @id @default(autoincrement())
  userId        Int
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  contactNumber String
  address       String
  city          String
  province      String
  zipCode       String
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Product {
  id               Int              @id @default(autoincrement())
  name             String           @unique
  type             String // e.g. Spandrel, Rib, Flat Type
  description      String?
  price            Float // Base selling price (after discount)
  originalPrice    Float? // Pre-discount original price
  discountPercent  Float            @default(30) // Discount percentage
  unit             String           @default("per meter")
  stock            Int // Base stock (fallback when no variants)
  imageUrl         String?
  imageUrls        String[]         @default([])
  color            String?
  isPreOrder       Boolean          @default(true)
  isActive         Boolean          @default(true)
  effectiveWidth   Float?
  nominalWidth     Float?
  ribHeight        Float?
  thickness        String?          @default("0.35mm")
  colors           String[]         @default([])
  maxMeters        Float?           @default(21.0)
  averageRating    Float            @default(0)
  reviewCount      Int              @default(0)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  variants         ProductVariant[]
  orderItems       OrderItem[]
  reviews          Review[]
  inventoryLogs    InventoryLog[]
}

model ProductVariant {
  id              Int            @id @default(autoincrement())
  productId       Int
  product         Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  name            String // e.g. "Per Meter", "2 Meters", "Bundle"
  color           String?
  price           Float // Selling price (after discount)
  originalPrice   Float? // Pre-discount original price
  discountPercent Float          @default(30) // Discount percentage
  stock           Int
  thickness       String?
  sku             String? // Optional SKU
  status          String         @default("available") // "available" | "out_of_stock"
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  orderItems      OrderItem[]
  inventoryLogs   InventoryLog[]
}

model Review {
  id        Int          @id @default(autoincrement())
  productId Int
  product   Product      @relation(fields: [productId], references: [id])
  userId    Int
  user      User         @relation(fields: [userId], references: [id])
  rating    Int          @default(5)
  title     String? // Review Title
  comment   String?
  imageUrls String[]     @default([]) // Array for multiple review images
  createdAt DateTime     @default(now())
  orderId   Int?
  order     Order?       @relation(fields: [orderId], references: [id])
  reply     ReviewReply?
}

model Order {
  id                    Int         @id @default(autoincrement())
  userId                Int
  user                  User        @relation(fields: [userId], references: [id])
  total                 Float
  status                String      @default("pending") // pending, processing, shipped, completed
  paymentStatus         String      @default("unpaid")
  paymentMode           String      @default("Cash on Delivery")
  fulfillmentType       String      @default("Delivery") // "Delivery" | "Pickup"
  customerName          String?
  customerEmail         String?
  shippingName          String?
  shippingContactNumber String?
  shippingAddress       String?
  shippingCity          String?
  shippingProvince      String?
  shippingZipCode       String?
  notes                 String?
  estimatedDeliveryDate DateTime?
  statusUpdatedAt       DateTime?   // Tracks when status last changed (used by auto-scheduler)
  createdAt             DateTime    @default(now())
  items                 OrderItem[]
  reviews               Review[]
  coilLogs              CoilInventoryLog[]
  refund                Refund?
}

model OrderItem {
  id          Int             @id @default(autoincrement())
  orderId     Int
  order       Order           @relation(fields: [orderId], references: [id])
  productId   Int
  product     Product         @relation(fields: [productId], references: [id])
  variantId   Int? // Optional: which variant was ordered
  variant     ProductVariant? @relation(fields: [variantId], references: [id])
  variantName String? // Snapshot of variant name at time of purchase
  quantity    Int
  price       Float // Price at time of purchase (variant price or base price)
  color       String?
  customLength Float?
  thickness   String?
}

model ProductType {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
}

model Inquiry {
  id          Int       @id @default(autoincrement())
  customerId  Int
  customer    User      @relation(fields: [customerId], references: [id])
  subject     String?
  status      String    @default("Open") // Open, In Progress, Resolved
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  messages    Message[]
}

model Message {
  id          Int       @id @default(autoincrement())
  inquiryId   Int
  inquiry     Inquiry   @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  senderId    Int
  sender      User      @relation(fields: [senderId], references: [id])
  content     String
  createdAt   DateTime  @default(now())
}

model ReviewReply {
  id        Int      @id @default(autoincrement())
  reviewId  Int      @unique
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  comment   String
  createdAt DateTime @default(now())
}

model InventoryLog {
  id            Int             @id @default(autoincrement())
  productId     Int
  product       Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId     Int?
  variant       ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  addedBy       Int?
  user          User?           @relation(fields: [addedBy], references: [id], onDelete: SetNull)
  previousStock Int
  addedQuantity Int
  newStock      Int
  reason        String?         @default("Restock")
  createdAt     DateTime        @default(now())
}

model UserSession {
  id           Int      @id @default(autoincrement())
  userId       Int
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionToken String   @unique
  deviceInfo   String?
  ipAddress    String?
  createdAt    DateTime @default(now())
  lastActive   DateTime @default(now())
  isActive     Boolean  @default(true)
  loggedOutAt  DateTime?
}

model SystemSetting {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}


model Expense {
  id          Int      @id @default(autoincrement())
  reference   String   @unique
  date        DateTime @default(now())
  category    String
  description String
  amount      Float
  status      String   @default("Approved")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CoilInventory {
  id              Int                @id @default(autoincrement())
  name            String             @default("Steel Coil")
  thickness       String             // e.g. "0.35mm", "0.40mm", "0.50mm", "0.60mm"
  color           String             // e.g. "Marshall Dark Gray"
  coilCount       Int                @default(1) // Physical count of coil rolls in stock
  minAlertCount   Int                @default(1) // Alert threshold for low stock (default 1 roll)
  availableMeters Float              @default(0) // Legacy / reference linear meters
  minAlertMeters  Float              @default(200) // Legacy alert threshold
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  logs            CoilInventoryLog[]

  @@unique([thickness, color])
}

model CoilInventoryLog {
  id              Int            @id @default(autoincrement())
  coilId          Int
  coil            CoilInventory  @relation(fields: [coilId], references: [id], onDelete: Cascade)
  userId          Int?
  user            User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  orderId         Int?
  order           Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  previousCount   Int            @default(0)
  coilsDeducted   Int            @default(0) // Positive for deduction, negative for restock
  remainingCount  Int            @default(0)
  previousMeters  Float          @default(0)
  metersDeducted  Float          @default(0)
  remainingMeters Float          @default(0)
  actionType      String         @default("deduction") // "deduction", "restock", "adjustment"
  reason          String?
  createdAt       DateTime       @default(now())
}

model Refund {
  id                   Int       @id @default(autoincrement())
  orderId              Int       @unique
  order                Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId               Int
  user                 User      @relation("CustomerRefunds", fields: [userId], references: [id], onDelete: Cascade)
  amount               Float
  paymentMethod        String
  reason               String?
  status               String    @default("pending") // pending, completed, failed
  processedBy          Int?
  processedByUser      User?     @relation("FinanceProcessedRefunds", fields: [processedBy], references: [id], onDelete: SetNull)
  transactionReference String?
  notes                String?
  refundedAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

