# ============================================================
# MEGA PACIFIC BACKEND - Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit your real .env file to version control!
# ============================================================

# --- Database ---
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/megaroof_db"

# --- JWT Secret ---
JWT_SECRET="your-super-secret-jwt-key-here"

# --- Email (SMTP) ---
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER="your_smtp_username"
SMTP_PASS="your_smtp_password"
SMTP_FROM="noreply@megapacific.com"

# --- Server ---
PORT=5000

# --- Seeder (optional) ---
# Used by prisma/seed.js. If not set, defaults to "admin@megapacific.com" / "ChangeMe@123"
# Set these before running `prisma db seed` in production!
SEED_ADMIN_EMAIL="admin@megapacific.com"
SEED_ADMIN_PASSWORD="your-secure-admin-password"
