# ============================================================
# MEGA PACIFIC BACKEND - Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit your real .env file to version control!
# ============================================================

# --- Database ---
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/megaroof_db"

# --- JWT Secret ---
JWT_SECRET="your-super-secret-jwt-key-here"

# --- Email (SMTP) ---
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER="your_smtp_username"
SMTP_PASS="your_smtp_password"
SMTP_FROM="noreply@megapacific.com"

# Server
PORT=5000

# Seeder / Bootstrap accounts (for production initialization)
# Used by prisma/seed.js and scripts/createSuperAdmin.js
SEED_SUPERADMIN_EMAIL="superadmin@megapacific.com"
SEED_SUPERADMIN_PASSWORD="your-secure-superadmin-password"
SEED_SUPERADMIN_NAME="Super Admin"

SEED_ADMIN_EMAIL="admin@megapacific.com"
SEED_ADMIN_PASSWORD="your-secure-admin-password"
SEED_ADMIN_NAME="System Admin"
